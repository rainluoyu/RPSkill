    "test:watch": "vitest",
    "test:browser": "node tests/browser-smoke.mjs"
  },
  "dependencies": {
    "@vue/devtools-api": "8.2.1",
    "dompurify": "3.4.17",
    "markdown-it": "15.0.3",
    "pinia": "4.1.0",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "jsdom": "31.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14",
    "playwright": "1.65.0"
  }
}
